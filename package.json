{
  "name": "github-desktop-build",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/renxotech/git-desktop.git"
  },
  "description": "Git Desktop build dependencies",
  "scripts": {
    "repair:notifications": "node script/notification-dependency.cjs --repair",
    "cli": "node script/checked-run.mjs app app/src/cli/main.ts",
    "check:eslint": "node script/type-check.mjs eslint",
    "test:eslint": "node script/test.mjs eslint-rules",
    "test:script": "node script/test.mjs script",
    "test": "node script/test.mjs",
    "test:unit": "node script/test.mjs",
    "test:setup": "node script/checked-run.mjs scripts script/test-setup.ts",
    "test:e2e": "npm run test:e2e:packaged --",
    "test:e2e:packaged": "npm run test:e2e:build:packaged && npm run test:e2e:run:packaged --",
    "test:e2e:unpackaged": "npm run test:e2e:build:unpackaged && npm run test:e2e:run:unpackaged --",
    "test:e2e:build": "npm run test:e2e:build:packaged --",
    "test:e2e:build:packaged": "cross-env DESKTOP_E2E_UPDATES_URL=http://127.0.0.1:51789/update NODE_ENV=production RELEASE_CHANNEL=production DESKTOP_E2E=1 npm run build:prod --",
    "test:e2e:build:unpackaged": "cross-env DESKTOP_E2E_UPDATES_URL=http://127.0.0.1:51789/update NODE_ENV=production RELEASE_CHANNEL=production DESKTOP_SKIP_PACKAGE=1 npm run build:prod --",
    "test:e2e:run": "npm run test:e2e:run:packaged --",
    "test:e2e:run:packaged": "node script/checked-run.mjs app node_modules/@playwright/test/cli.js test --config app/test/e2e/playwright.config.ts",
    "test:e2e:run:unpackaged": "cross-env DESKTOP_E2E_APP_MODE=unpackaged node script/checked-run.mjs app node_modules/@playwright/test/cli.js test --config app/test/e2e/playwright.config.ts",
    "postinstall": "node script/checked-run.mjs bootstrap script/post-install.ts",
    "start": "cross-env NODE_ENV=development node script/checked-run.mjs all script/start.ts",
    "start:prod": "cross-env NODE_ENV=production node script/checked-run.mjs all script/start.ts",
    "start:test": "cross-env NODE_ENV=production DESKTOP_BUILD_TARGET=test node script/checked-run.mjs all script/start.ts",
    "profile:refresh-test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File script/refresh-test-profile.ps1",
    "compile:dev": "cross-env NODE_ENV=development node script/checked-run.mjs scripts node_modules/webpack-cli/bin/cli.js --disable-interpret --config app/webpack.development.ts",
    "compile:prod": "cross-env NODE_ENV=production NODE_OPTIONS='--max_old_space_size=4096' node script/checked-run.mjs scripts node_modules/webpack-cli/bin/cli.js --disable-interpret --config app/webpack.production.ts",
    "build:dev": "npm run compile:dev && cross-env NODE_ENV=development node script/checked-run.mjs scripts script/build.ts",
    "build:prod": "npm run compile:prod && cross-env NODE_ENV=production node script/checked-run.mjs scripts script/build.ts",
    "build:test": "cross-env DESKTOP_BUILD_TARGET=test npm run build:prod",
    "package": "node script/checked-run.mjs all script/package.ts",
    "generate-octicons": "node script/checked-run.mjs scripts script/generate-octicons.ts",
    "generate-example-usage-data": "node script/type-check.mjs app && cross-env TEST_ENV=1 node --disable-warning=ExperimentalWarning --experimental-test-module-mocks --conditions=import --import tsx --import ./app/test/globals.mts script/generate-example-usage-data.mjs",
    "compile:script": "node script/type-check.mjs scripts",
    "lint": "npm run prettier && npm run lint:src --",
    "lint:fix": "npm run prettier -- --write && npm run lint:src:fix --",
    "markdownlint": "markdownlint **/*.{md,mdx} --config .markdownlint.js --rules .markdownlint-rules.js --ignore node_modules --ignore gemoji",
    "prettier": "prettier --check \"./**/*.{ts,tsx,mts,mjs,js,json,jsx,scss,html,yaml,yml}\" \"./eslint-rules/**/*.mjs\"",
    "lint:src": "npm run eslint-check && npm run eslint --",
    "lint:src:fix": "npm run eslint -- --fix",
    "eslint": "eslint --cache --rulesdir ./eslint-rules \"./eslint-rules/**/*.{js,mjs}\" \"./script/**/*.{ts,tsx,mts,mjs}\" \"./app/{src,typings,test}/**/*.{js,jsx,ts,tsx,mts}\" \"./changelog.json\"",
    "eslint-check": "eslint --print-config .eslintrc.* | eslint-config-prettier-check",
    "validate-electron-version": "node script/checked-run.mjs scripts script/validate-electron-version.ts",
    "validate-macos-version": "node script/checked-run.mjs scripts script/validate-macos-version.ts",
    "clean-slate": "rimraf out node_modules app/node_modules && npm ci",
    "rebuild-hard:dev": "npm run clean-slate && npm run build:dev --",
    "rebuild-hard:prod": "npm run clean-slate && npm run build:prod --",
    "draft-release": "node script/checked-run.mjs scripts script/draft-release/index.ts",
    "draft-release:format": "prettier --check --write changelog.json app/package.json && npm run validate-changelog --",
    "draft-release:pr": "node script/checked-run.mjs scripts script/draft-release/draft-pull-request.ts",
    "validate-changelog": "node script/checked-run.mjs scripts script/validate-changelog.ts",
    "package:local": "node script/package-local.mjs",
    "typecheck": "node script/type-check.mjs"
  },
  "author": {
    "name": "GitHub, Inc.",
    "email": "opensource+desktop@github.com",
    "url": "https://desktop.github.com/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">= 11.17.0"
  },
  "overrides": {
    "@github/markdownlint-github": {
      "markdown-it": "14.3.3"
    },
    "@types/react-css-transition-replace": {
      "@types/react": "$@types/react"
    },
    "markdownlint-cli": {
      "js-yaml": "5.4.3",
      "smol-toml": "1.9.1"
    }
  },
  "dependencies": {
    "@primer/octicons": "^19.28.1",
    "@types/which": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/typescript-estree": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "awesome-node-loader": "^1.1.1",
    "chalk": "^5.3.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-jsdoc": "^50.6.2",
    "eslint-plugin-json": "^2.1.1",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-react": "^7.37.5",
    "fake-indexeddb": "^6.0.0",
    "front-matter": "^2.3.0",
    "glob": "^7.1.2",
    "global-jsdom": "^26.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^26.0.0",
    "legal-eagle": "0.16.0",
    "mini-css-extract-plugin": "^2.9.1",
    "parse-dds": "^1.2.1",
    "prettier": "^2.6.0",
    "printenvz": "file:vendor/printenvz",
    "process-proxy": "^0.6.0",
    "rimraf": "^6.0.1",
    "sass": "^1.27.0",
    "sass-loader": "^16.0.0",
    "semver": "^7.6.3",
    "style-loader": "^3.3.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "webpack": "^5.111.0",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-dev-middleware": "^7.4.5",
    "webpack-hot-middleware": "^2.25.1",
    "webpack-merge": "^6.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild-loader": "4.5.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@github/markdownlint-github": "^0.8.3",
    "@playwright/test": "^1.58.2",
    "@types/byline": "^4.2.31",
    "@types/classnames": "^2.2.2",
    "@types/codemirror": "^5.60.15",
    "@types/deep-equal": "^1.0.1",
    "@types/dompurify": "^2.3.1",
    "@types/electron-winstaller": "^4.0.0",
    "@types/eslint": "^8.4.1",
    "@types/estree": "^0.0.49",
    "@types/event-kit": "^2.4.1",
    "@types/express": "^4.11.0",
    "@types/fuzzaldrin-plus": "^0.0.1",
    "@types/glob": "^5.0.35",
    "@types/klaw-sync": "^6.0.0",
    "@types/legal-eagle": "^0.15.0",
    "@types/lodash": "^4.17.25",
    "@types/marked": "^4.0.1",
    "@types/memoize-one": "^3.1.1",
    "@types/minimist": "^1.2.5",
    "@types/mri": "^1.1.0",
    "@types/node": "22.10.9",
    "@types/parse-dds": "^1.0.3",
    "@types/plist": "^3.0.2",
    "@types/prettier": "^2.0.1",
    "@types/react": "^16.14.62",
    "@types/react-css-transition-replace": "^2.1.3",
    "@types/react-dom": "^16.8.2",
    "@types/react-transition-group": "^4.4.0",
    "@types/react-virtualized": "^9.7.12",
    "@types/request": "^2.0.9",
    "@types/reserved-words": "^0.1.0",
    "@types/semver": "^5.5.0",
    "@types/source-map-support": "^0.5.2",
    "@types/split2": "^4.2.3",
    "@types/strip-ansi": "^3.0.0",
    "@types/textarea-caret": "^3.0.0",
    "@types/to-camel-case": "^1.0.0",
    "@types/triple-beam": "^1.3.2",
    "@types/ua-parser-js": "^0.7.30",
    "@types/untildify": "^3.0.0",
    "@types/username": "^3.0.0",
    "@types/webgl2": "^0.0.11",
    "@types/webpack": "^5.28.5",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@types/webpack-hot-middleware": "^2.25.9",
    "diff": "^8.0.3",
    "electron": "44.9.1",
    "electron-winstaller": "^5.0.0",
    "eslint-plugin-github": "^5.1.5",
    "markdownlint-cli": "^0.49.1",
    "node-test-github-reporter": "^1.3.2",
    "playwright": "^1.58.2",
    "reserved-words": "^0.1.2",
    "tsconfig-paths": "^3.9.0",
    "tsx": "^4.19.3",
    "webpack-cli": "^6.0.1"
  }
}
