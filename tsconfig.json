{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "target": "ES2022",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "jsx": "react",
    "strict": true,
    "outDir": "./out",
    "useUnknownInCatchVariables": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Array"],
    "types": ["node"],
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": true,
    "noEmitOnError": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.mts",
    "script/generate-example-usage-data.mjs",
    "app/**/*.d.tsx"
  ],
  "exclude": [
    "node_modules",
    "app/node_modules",
    "dist",
    "out",
    "app/src/highlighter"
  ],
  "compileOnSave": false
}
