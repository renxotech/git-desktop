{
  "name": "desktop-notifications",
  "version": "0.2.6",
  "description": "A simple and opinionated library for handling Windows notifications",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "install": "node-gyp rebuild --napi_build_version=4 && node script/compile-typescript.cjs && node script/build-receipt.cjs",
    "build": "node script/compile-typescript.cjs",
    "pretest": "npm run build",
    "prettify": "prettier --write \"./**/*.{ts,tsx,js,json,jsx,scss,html,yaml,yml}\"",
    "check-prettier": "prettier --check \"./**/*.{ts,tsx,js,json,jsx,scss,html,yaml,yml}\""
  },
  "devDependencies": {
    "node-gyp": "^10.1.0",
    "prettier": "^2.0.5",
    "typescript": "7.0.2",
    "@types/node": "22.10.9"
  },
  "dependencies": {
    "node-addon-api": "^7.0.0"
  },
  "binary": {
    "napi_versions": [
      4
    ]
  },
  "config": {
    "runtime": "napi",
    "target": 4
  },
  "type": "commonjs"
}
